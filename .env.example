# =============================================================================
# .env.example — committed to git as the template
# WHY: documents which env vars the project needs WITHOUT exposing real values
# Copy this to .env and fill in real keys. .env is gitignored.
# =============================================================================

# Groq API — primary provider for system under test
# Get yours: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Google AI Studio — secondary provider + judge model
# Get yours: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Default models (override per call if needed)
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# Harness behavior
HARNESS_LOG_LEVEL=INFO
HARNESS_TRACE_DIR=traces

# ===== Corporate network workaround (DEV ONLY) =====
# WHY: when set to true, the LLM HTTP client skips SSL certificate verification.
# This is needed on networks with SSL inspection proxies that present a
# self-signed certificate (e.g., corporate Zscaler/Netskope environments)
# when the corporate root CA isn't installed in the Python cert bundle.
#
# DO NOT enable this in production. The proper fix is to install the corporate
# CA via SSL_CERT_FILE / REQUESTS_CA_BUNDLE environment variables.
HARNESS_INSECURE_SKIP_TLS_VERIFY=false